&soil_data_nml
soiltype = 3,
WaterLeakRate = 0.0, ! fraction per day
thksl    = 0.1, 0.2, 0.4, 0.8, 1.5,  ! m, soil layer thickness
/

&vegn_parameters_nml
f_iniBSW   = 0.1,
